+  function segmentRectHitT(x1,y1,x2,y2,rect,pad=0){
+    const minX=rect.x-pad,maxX=rect.x+rect.w+pad,minY=rect.y-pad,maxY=rect.y+rect.h+pad;
+    const dx=x2-x1,dy=y2-y1;
+    let tmin=0,tmax=1;
+    const axis=(p,d,min,max)=>{
+      if(Math.abs(d)<1e-9) return (p>=min&&p<=max)?[-Infinity,Infinity]:null;
+      let a=(min-p)/d,b=(max-p)/d;if(a>b){const q=a;a=b;b=q}return[a,b];
+    };
+    const ax=axis(x1,dx,minX,maxX),ay=axis(y1,dy,minY,maxY);
+    if(!ax||!ay)return null;
+    tmin=Math.max(tmin,ax[0],ay[0]);tmax=Math.min(tmax,ax[1],ay[1]);
+    return tmax>=tmin&&tmax>=0&&tmin<=1?Math.max(0,tmin):null;
+  }
